{%- comment -%}
  Product description + Size Guide / Fabric & Care / Shipping & Returns accordions,
  built to match kantara-fashion-en-ar/english/product.html (.product-description
  and .product-details). Description comes from the real product.
{%- endcomment -%}

<div class="cpd">
  {%- if product.description != blank -%}
    <div class="cpd__description">
      <div class="cpd__desc-text cpd__desc-text--collapsed" data-cpd-desc>{{ product.description }}</div>
      <button
        type="button"
        class="cpd__desc-toggle"
        data-cpd-toggle
        data-more="{{ 'content.see_more' | t }}"
        data-less="{{ 'content.see_less' | t }}"
        hidden
      >
        {{ 'content.see_more' | t }}
      </button>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="cpd__details">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading }}</summary>
          <div class="cpd__panel">{{ block.settings.text }}</div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    document.querySelectorAll('[data-cpd-desc]').forEach(function (text) {
      var toggle = text.parentElement.querySelector('[data-cpd-toggle]');
      if (!toggle || toggle.dataset.ready) return;
      toggle.dataset.ready = '1';
      if (text.scrollHeight - text.clientHeight > 2) toggle.hidden = false;
      else text.classList.remove('cpd__desc-text--collapsed');
      toggle.addEventListener('click', function () {
        var collapsed = text.classList.toggle('cpd__desc-text--collapsed');
        toggle.textContent = collapsed ? toggle.dataset.more : toggle.dataset.less;
      });
    });
  })();
</script>

{% stylesheet %}
  .cpd {
    max-width: 640px;
    margin: 0 auto;
    padding: 0.5rem 1.75rem 0.625rem;
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    color: var(--custom-ink, #121212);
  }

  .cpd__desc-text {
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--custom-mute, #8b8579);
  }

  .cpd__desc-text p {
    margin: 0;
  }

  .cpd__desc-text--collapsed {
    max-height: 5.7em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
  }

  .cpd__desc-toggle {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.71875rem;
    color: var(--custom-ink, #121212);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .cpd__details {
    padding-top: 1.875rem;
    margin-top: 1.875rem;
    border-top: 1px solid var(--custom-line, #e7e5e0);
  }

  .cpd__details details {
    border-bottom: 1px solid var(--custom-line, #e7e5e0);
  }

  .cpd__details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 0;
    font-size: 0.71875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cpd__details summary::-webkit-details-marker {
    display: none;
  }

  .cpd__details summary::after {
    content: '+';
    font-size: 0.9375rem;
    color: var(--custom-mute, #8b8579);
  }

  .cpd__details details[open] summary::after {
    content: '\2013';
  }

  .cpd__panel {
    max-width: 30rem;
    padding-bottom: 1.125rem;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--custom-mute, #8b8579);
  }

  .cpd__panel p {
    margin: 0;
  }

  html[dir='rtl'] .cpd,
  html[dir='rtl'] .cpd__details summary {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    letter-spacing: 0;
    text-transform: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "blocks": [
    {
      "type": "detail",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Size Guide" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add details here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "detail", "settings": { "heading": "Size Guide", "text": "<p>Refer to the custom size chart above, or reach out and our team will help you choose.</p>" } },
        { "type": "detail", "settings": { "heading": "Fabric & Care", "text": "<p>Luxury lined chiffon with hand embroidery in silver thread. Dry clean only.</p>" } },
        { "type": "detail", "settings": { "heading": "Shipping & Returns", "text": "<p>Free shipping on orders over AED 300. Free returns within 14 days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
