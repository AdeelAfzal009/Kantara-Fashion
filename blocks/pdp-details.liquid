{%- assign product = closest.product -%}
<div class="cpd" {{ block.shopify_attributes }}>
  {%- if product.description != blank -%}
    <div class="cpd__description">
      <div class="cpd__desc-text cpd__desc-text--collapsed" data-cpd-desc>{{ product.description }}</div>
      <button type="button" class="cpd__desc-toggle" data-cpd-toggle data-more="{{ 'content.see_more' | t }}" data-less="{{ 'content.see_less' | t }}" hidden>{{ 'content.see_more' | t }}</button>
    </div>
  {%- endif -%}
  <div class="cpd__details">
    {%- for i in (1..3) -%}
      {%- assign hk = 'heading_' | append: i -%}
      {%- assign tk = 'text_' | append: i -%}
      {%- if block.settings[hk] != blank -%}
        <details>
          <summary>{{ block.settings[hk] }}</summary>
          <div class="cpd__panel">{{ block.settings[tk] }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-cpd-desc]').forEach(function (text) {
      var toggle = text.parentElement.querySelector('[data-cpd-toggle]');
      if (!toggle || toggle.dataset.ready) return;
      toggle.dataset.ready = '1';
      if (text.scrollHeight - text.clientHeight > 2) toggle.hidden = false;
      else text.classList.remove('cpd__desc-text--collapsed');
      toggle.addEventListener('click', function () {
        var collapsed = text.classList.toggle('cpd__desc-text--collapsed');
        toggle.textContent = collapsed ? toggle.dataset.more : toggle.dataset.less;
      });
    });
  })();
</script>

{% stylesheet %}
  .cpd {
    width: 100%;
    padding: 0;
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    color: var(--custom-ink, #121212);
  }

  .cpd__desc-text {
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--custom-mute, #8b8579);
  }

  .cpd__desc-text p {
    margin: 0;
  }

  .cpd__desc-text--collapsed {
    max-height: 5.7em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
  }

  .cpd__desc-toggle {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.71875rem;
    color: var(--custom-ink, #121212);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .cpd__details {
    padding-top: 1.875rem;
    margin-top: 1.875rem;
    border-top: 1px solid var(--custom-line, #e7e5e0);
  }

  .cpd__details details {
    border-bottom: 1px solid var(--custom-line, #e7e5e0);
  }

  .cpd__details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 0;
    font-size: 0.71875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cpd__details summary::-webkit-details-marker {
    display: none;
  }

  .cpd__details summary::after {
    content: '+';
    font-size: 0.9375rem;
    color: var(--custom-mute, #8b8579);
  }

  .cpd__details details[open] summary::after {
    content: '\2013';
  }

  .cpd__panel {
    max-width: 30rem;
    padding-bottom: 1.125rem;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--custom-mute, #8b8579);
  }

  .cpd__panel p {
    margin: 0;
  }

  html[dir='rtl'] .cpd,
  html[dir='rtl'] .cpd__details summary {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    letter-spacing: 0;
    text-transform: none;
  }
{% endstylesheet %}

{% schema %}
