{%- doc -%}
  Renders the "Custom Size" measurement panel for the product page.

  Placeholder content pending final requirements/copy from the client — the
  fields below are dummy measurements (not yet wired to cart/line-item
  properties) so the tab has something real to look at in the meantime.

  Hidden/shown by the sibling "size-tabs" block; see size-tabs.liquid.
{%- enddoc -%}

<custom-size-panel class="custom-size-panel" {{ block.shopify_attributes }}>
  <fieldset class="custom-size-panel__unit-toggle">
    <legend class="visually-hidden">{{ 'content.unit' | t }}</legend>
    <label class="custom-size-panel__unit-btn">
      <input type="radio" name="custom-size-unit-{{ block.id }}" value="cm" checked>
      <span>CM</span>
    </label>
    <label class="custom-size-panel__unit-btn">
      <input type="radio" name="custom-size-unit-{{ block.id }}" value="in">
      <span>IN</span>
    </label>
  </fieldset>

  <div class="custom-size-panel__diagram">
    <svg viewBox="0 0 140 225" aria-hidden="true">
      <circle class="m-figure" cx="60" cy="15" r="9" />
      <path
        class="m-figure"
        d="M45,30 C40,30 32,32 30,35 L20,115 C18,145 15,172 12,197 L108,197 C105,172 102,145 100,115 L90,35 C88,32 80,30 75,30 Z"
      />
      <path class="m-figure" d="M30,35 L5,92 L15,118 L38,62 Z" />
      <path class="m-figure" d="M90,35 L115,92 L105,118 L82,62 Z" />

      <line class="m-line" x1="30" y1="33" x2="90" y2="33" />
      <circle class="m-dot" cx="97" cy="33" r="6" />
      <text x="97" y="33.5">1</text>

      <line class="m-line" x1="28" y1="55" x2="92" y2="55" />
      <circle class="m-dot" cx="99" cy="55" r="6" />
      <text x="99" y="55.5">2</text>

      <line class="m-line" x1="35" y1="88" x2="85" y2="88" />
      <circle class="m-dot" cx="92" cy="88" r="6" />
      <text x="92" y="88.5">3</text>

      <line class="m-line" x1="18" y1="140" x2="102" y2="140" />
      <circle class="m-dot" cx="109" cy="140" r="6" />
      <text x="109" y="140.5">4</text>

      <line class="m-line" x1="88" y1="38" x2="112" y2="112" />
      <circle class="m-dot" cx="118" cy="118" r="6" />
      <text x="118" y="118.5">5</text>

      <line class="m-line" x1="8" y1="32" x2="8" y2="196" />
      <circle class="m-dot" cx="8" cy="208" r="6" />
      <text x="8" y="208.5">6</text>
    </svg>
  </div>

  <div class="custom-size-panel__fields">
    {% assign measurements = 'Shoulder,Bust,Waist,Hip,Sleeve Length,Total Length' | split: ',' %}
    {% for measurement in measurements %}
      <label class="custom-size-panel__field">
        <span class="custom-size-panel__field-label">
          <span class="custom-size-panel__badge">{{ forloop.index }}</span>
          {{ measurement }}
        </span>
        <input type="number" inputmode="decimal" placeholder="0" name="properties[{{ measurement }}]">
      </label>
    {% endfor %}
  </div>

  <p class="custom-size-panel__note">{{ 'content.custom_size_note' | t }}</p>
</custom-size-panel>

{% stylesheet %}
  custom-size-panel {
    display: block;
  }

  .custom-size-panel__unit-toggle {
    display: inline-flex;
    border: 1px solid #e7e5e0;
    margin: 0 0 1.375rem;
    padding: 0;
  }

  .custom-size-panel__unit-btn {
    position: relative;
    display: inline-flex;
    padding: 0.4375rem 1.125rem;
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    cursor: pointer;
  }

  .custom-size-panel__unit-btn input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .custom-size-panel__unit-btn:has(input:checked) {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .custom-size-panel__diagram {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .custom-size-panel__diagram svg {
    width: 100%;
    max-width: 11.25rem;
    height: auto;
  }

  .custom-size-panel__diagram .m-line {
    stroke: rgb(var(--color-foreground-rgb) / 0.45);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .custom-size-panel__diagram .m-figure {
    stroke: var(--color-foreground);
    stroke-width: 1.1;
    fill: none;
  }

  .custom-size-panel__diagram .m-dot {
    fill: var(--color-foreground);
  }

  .custom-size-panel__diagram text {
    font-size: 0.4375rem;
    fill: var(--color-background);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .custom-size-panel__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 0.875rem;
    margin-bottom: 1rem;
  }

  .custom-size-panel__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .custom-size-panel__field-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .custom-size-panel__badge {
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: 50%;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.5625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .custom-size-panel__field input {
    border: none;
    border-bottom: 1px solid #e7e5e0;
    padding: 0.5rem 0.125rem;
    font-size: 0.84375rem;
    font-family: inherit;
    color: var(--color-foreground);
    background: transparent;
  }

  .custom-size-panel__field input:focus {
    outline: none;
    border-color: var(--color-foreground);
  }

  .custom-size-panel__note {
    font-size: 0.71875rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom size",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Custom size"
    }
  ]
}
{% endschema %}
