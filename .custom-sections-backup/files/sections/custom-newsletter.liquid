{%- liquid
  # `| t` must only ever see a translation key, never merchant-authored copy.
  assign placeholder = section.settings.placeholder
  if placeholder == blank
    assign placeholder = 'blocks.email_signup.placeholder' | t
  endif
  assign button_label = section.settings.button_label | default: 'Subscribe'
-%}

<section
  class="custom-newsletter{% if section.settings.border_top %} custom-newsletter--border-top{% endif %}{% if section.settings.border_bottom %} custom-newsletter--border-bottom{% endif %}"
  style="
    --custom-newsletter-bg: {{ section.settings.background_color }};
    --custom-newsletter-color: {{ section.settings.text_color }};
    --custom-newsletter-rule: {{ section.settings.rule_color }};
    --custom-newsletter-padding-top: {{ section.settings.padding_top }}px;
    --custom-newsletter-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-custom-reveal-group
>
  <div class="custom-newsletter__inner custom-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <p class="custom-eyebrow custom-newsletter__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="custom-display custom-newsletter__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="custom-newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'custom-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      <div class="custom-newsletter__field">
        <label class="visually-hidden" for="CustomNewsletter-{{ section.id }}">
          {{- 'blocks.email_signup.label' | t -}}
        </label>
        <input
          id="CustomNewsletter-{{ section.id }}"
          class="custom-newsletter__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ placeholder }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="CustomNewsletter-error-{{ section.id }}"
          {% endif %}
        >
        <button class="custom-newsletter__button" type="submit">
          {{ button_label }}
        </button>
      </div>

      {%- if form.errors -%}
        <p class="custom-newsletter__message custom-newsletter__message--error" id="CustomNewsletter-error-{{ section.id }}" tabindex="-1">
          {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
        </p>
      {%- elsif form.posted_successfully? -%}
        <p class="custom-newsletter__message" tabindex="-1">
          {{- 'blocks.email_signup.success' | t -}}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .custom-newsletter {
    background: var(--custom-newsletter-bg);
    color: var(--custom-newsletter-color);
    padding-block: var(--custom-newsletter-padding-top) var(--custom-newsletter-padding-bottom);
    padding-inline: var(--custom-gutter);
    text-align: center;
  }

  .custom-newsletter--border-top {
    border-top: 1px solid var(--custom-line);
  }

  .custom-newsletter--border-bottom {
    border-bottom: 1px solid var(--custom-line);
  }

  .custom-newsletter__inner {
    max-width: 640px;
    margin-inline: auto;
  }

  .custom-newsletter__eyebrow {
    margin: 0 0 14px;
  }

  .custom-newsletter__heading {
    font-size: clamp(22px, 2.6vw, 28px);
    margin: 0 0 12px;
    color: var(--custom-ink);
  }

  .custom-newsletter__text {
    font-family: var(--custom-font-ui);
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .custom-newsletter__form {
    margin: 0;
  }

  .custom-newsletter__field {
    display: flex;
    align-items: center;
    max-width: 380px;
    margin-inline: auto;
    border-bottom: 1px solid var(--custom-newsletter-rule);
  }

  .custom-newsletter__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    padding: 10px 4px;
    font-family: inherit;
    font-size: 13.5px;
    color: var(--custom-ink);
  }

  .custom-newsletter__input:focus-visible {
    outline: none;
  }

  .custom-newsletter__field:focus-within {
    border-bottom-color: var(--custom-ink);
  }

  .custom-newsletter__input::placeholder {
    color: var(--custom-mute);
  }

  .custom-newsletter__button {
    flex: none;
    border: 0;
    background: none;
    cursor: pointer;
    padding: 10px 0 10px 12px;
    font-family: var(--custom-font-ui);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--custom-ink);
    transition: opacity 0.3s var(--custom-easing);
  }

  [dir='rtl'] .custom-newsletter__button {
    padding: 10px 12px 10px 0;
  }

  .custom-newsletter__button:hover {
    opacity: 0.6;
  }

  .custom-newsletter__message {
    font-family: var(--custom-font-ui);
    font-size: 12px;
    margin: 14px 0 0;
  }

  .custom-newsletter__message--error {
    color: var(--color-error, #b3261e);
  }

  /* Desktop: the rule widens and the copy gets room to breathe, so the block reads
     as a deliberate pause between the product grid and the footer. */
  @media screen and (min-width: 750px) {
    .custom-newsletter__heading {
      margin-bottom: 14px;
    }

    .custom-newsletter__text {
      font-size: 15px;
      margin-bottom: 28px;
    }

    .custom-newsletter__field {
      max-width: 440px;
    }

    .custom-newsletter__input {
      padding-block: 12px;
      font-size: 14.5px;
    }

    .custom-newsletter__button {
      font-size: 11.5px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom newsletter",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Subscribe for early access to new arrivals"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show top border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#8b8579"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Input underline",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Custom newsletter"
    }
  ]
}
{% endschema %}
