{%- liquid
  assign socials = 'instagram,tiktok,whatsapp,facebook,pinterest,youtube,x,snapchat' | split: ','

  assign social_count = 0
  for network in socials
    assign key = network | append: '_url'
    if section.settings[key] != blank
      assign social_count = social_count | plus: 1
    endif
  endfor

  assign column_blocks = section.blocks | where: 'type', 'column'
-%}

<script src="{{ 'custom-footer.js' | asset_url }}" defer></script>

<div
  class="custom-footer"
  data-custom-footer
  style="
    --custom-footer-bg: {{ section.settings.background_color }};
    --custom-footer-color: {{ section.settings.text_color }};
    --custom-footer-line: {{ section.settings.line_color }};
    --custom-footer-bar-bg: {{ section.settings.bar_background }};
    --custom-footer-logo-height: {{ section.settings.logo_height }}px;
  "
>
  <div class="custom-footer__inner">
    {%- if section.settings.logo != blank -%}
      <a class="custom-footer__logo" href="{{ routes.root_url }}">
        {{
          section.settings.logo
          | image_url: width: 800
          | image_tag: widths: '200, 400, 600, 800', sizes: '200px', loading: 'lazy', alt: shop.name
        }}
      </a>
    {%- elsif section.settings.logo_text != blank -%}
      <a class="custom-footer__logo custom-footer__logo--text custom-display" href="{{ routes.root_url }}">
        {{- section.settings.logo_text -}}
      </a>
    {%- endif -%}

    {%- if column_blocks.size > 0 -%}
      <div class="custom-footer__columns">
        {%- for block in column_blocks -%}
          {%- assign block_menu = linklists[block.settings.menu] -%}
          {%- if block.settings.heading != blank or block_menu.links.size > 0 -%}
            {%- comment -%}
              <details> is an accordion on mobile with no JS at all; custom-footer.js
              opens and pins them once the columns lay out side by side.
            {%- endcomment -%}
            <details class="custom-footer__column" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.heading }}</span>
              </summary>
              {%- if block_menu.links.size > 0 -%}
                <ul>
                  {%- for link in block_menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="custom-footer__utility">
      {%- if section.settings.show_localization -%}
        {%- form 'localization', class: 'custom-footer__localization' -%}
          {%- if localization.available_countries.size > 1 -%}
            <div class="custom-footer__select">
              <label class="visually-hidden" for="CustomFooterCountry-{{ section.id }}">
                {{- 'accessibility.country_region' | t -}}
              </label>
              <span class="custom-footer__select-label">{{ section.settings.ship_to_label }}</span>
              <select
                id="CustomFooterCountry-{{ section.id }}"
                name="country_code"
                data-custom-footer-submit
              >
                {%- for country in localization.available_countries -%}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }})
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          {%- if localization.available_languages.size > 1 -%}
            <div class="custom-footer__select">
              <label class="visually-hidden" for="CustomFooterLanguage-{{ section.id }}">
                {{- 'content.language' | t -}}
              </label>
              <select
                id="CustomFooterLanguage-{{ section.id }}"
                name="locale_code"
                data-custom-footer-submit
              >
                {%- for language in localization.available_languages -%}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      {%- if social_count > 0 -%}
        <ul class="custom-footer__social">
          {%- for network in socials -%}
            {%- assign key = network | append: '_url' -%}
            {%- assign url = section.settings[key] -%}
            {%- if url != blank -%}
              <li>
                <a href="{{ url }}" rel="noopener" target="_blank" aria-label="{{ network }}">
                  {%- render 'custom-icon', icon: network -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="custom-footer__bar">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- if section.settings.tagline != blank -%}
      <span>{{ section.settings.tagline }}</span>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .custom-footer {
    background: var(--custom-footer-bg);
    color: var(--custom-footer-color);
  }

  .custom-footer__inner {
    max-width: 640px;
    margin-inline: auto;
    padding: 80px var(--custom-gutter) 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .custom-footer__logo {
    margin-block-end: 44px;
    text-decoration: none;
    color: inherit;
  }

  .custom-footer__logo img {
    height: var(--custom-footer-logo-height);
    width: auto;
    object-fit: contain;
  }

  .custom-footer__logo--text {
    font-size: 30px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .custom-footer__columns {
    width: 100%;
    border-block-start: 1px solid var(--custom-footer-line);
  }

  .custom-footer__column {
    border-block-end: 1px solid var(--custom-footer-line);
  }

  .custom-footer__column summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-block: 18px;
    font-size: 13.5px;
    letter-spacing: 0.02em;
  }

  .custom-footer__column summary::-webkit-details-marker {
    display: none;
  }

  .custom-footer__column summary::after {
    content: '+';
    font-size: 15px;
    color: var(--custom-mute);
  }

  .custom-footer__column[open] summary::after {
    content: '–';
  }

  .custom-footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0 0 16px;
    display: grid;
    gap: 10px;
  }

  .custom-footer__column a {
    font-size: 13px;
    color: var(--custom-mute);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .custom-footer__column a:hover {
    color: var(--custom-footer-color);
  }

  .custom-footer__utility {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-block-start: 26px;
  }

  .custom-footer__localization {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin: 0;
  }

  .custom-footer__select {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--custom-font-ui);
    font-size: 12.5px;
    color: var(--custom-mute);
  }

  .custom-footer__select select {
    border: 0;
    background: none;
    font: inherit;
    color: var(--custom-footer-color);
    cursor: pointer;
    padding: 2px 0;
  }

  .custom-footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .custom-footer__social a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--custom-footer-line);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .custom-footer__social a:hover {
    background: var(--custom-grey);
    border-color: var(--custom-grey-deep);
  }

  .custom-footer__social .custom-icon {
    width: 15px;
    height: 15px;
    stroke-width: 1.3;
    color: var(--custom-footer-color);
  }

  .custom-footer__bar {
    background: var(--custom-footer-bar-bg);
    border-block-start: 1px solid var(--custom-footer-line);
    padding: 12px var(--custom-gutter);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-family: var(--custom-font-ui);
    font-size: 10.5px;
    color: var(--custom-mute);
  }

  /* Desktop: the accordions unfold into open columns. The disclosure affordance is
     dropped rather than merely hidden — with the lists always open it would lie. */
  @media screen and (min-width: 750px) {
    .custom-footer__inner {
      max-width: var(--custom-page-max);
      padding-block: 96px 40px;
    }

    .custom-footer__logo {
      margin-block-end: 60px;
    }

    .custom-footer__columns {
      border-block-start: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 40px;
      max-width: 860px;
      padding-block-end: 52px;
    }

    .custom-footer__column {
      border-block-end: 0;
      text-align: start;
    }

    .custom-footer__column summary {
      cursor: default;
      justify-content: flex-start;
      padding-block: 0 18px;
      font-family: var(--custom-font-ui);
      font-size: 10.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--custom-mute);
      pointer-events: none;
    }

    [dir='rtl'] .custom-footer__column summary {
      font-family: var(--custom-font-arabic);
      letter-spacing: 0;
      text-transform: none;
      font-size: 12px;
    }

    .custom-footer__column summary::after {
      content: none;
    }

    .custom-footer__column ul {
      padding-block-end: 0;
      gap: 12px;
    }

    .custom-footer__utility {
      flex-direction: row;
      justify-content: space-between;
      border-block-start: 1px solid var(--custom-footer-line);
      padding-block-start: 32px;
    }

    .custom-footer__localization {
      justify-content: flex-start;
    }

    .custom-footer__bar {
      justify-content: space-between;
      padding-inline: var(--custom-gutter);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text fallback",
      "info": "Used when no logo image is set.",
      "default": "KF"
    },
    {
      "type": "header",
      "content": "Region and language"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show region and language pickers",
      "info": "Each picker appears once more than one option is published in Settings → Markets.",
      "default": true
    },
    {
      "type": "text",
      "id": "ship_to_label",
      "label": "Region label",
      "default": "Ship to"
    },
    {
      "type": "header",
      "content": "Social"
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "x_url", "label": "X" },
    { "type": "url", "id": "snapchat_url", "label": "Snapchat" },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Crafted with care in the UAE"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Rules and borders",
      "default": "#e7e5e0"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bottom bar background",
      "default": "#e7e4dc"
    }
  ],
  "presets": [
    {
      "name": "Custom footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Shop" } },
        { "type": "column", "settings": { "heading": "About Kantara" } },
        { "type": "column", "settings": { "heading": "Client Services" } }
      ]
    }
  ]
}
{% endschema %}
