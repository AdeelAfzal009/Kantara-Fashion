{%- doc -%}
  Renders a thin-stroke line icon for the `custom-*` sections.

  The theme's own `icon` snippet draws filled paths; this set is stroked to match the
  Kantara design language. Renders the full <svg> element, not just the paths.

  @param {string} icon - A utility icon (shipping, returns, payment, secure, gift, support,
    exchange, globe), a brand-value icon (star, fabric, shield, hand, leaf, sparkle), or a
    social mark (instagram, tiktok, whatsapp, facebook, pinterest, youtube, x, snapchat).
  @param {string} [class] - Additional classes on the <svg>
{%- enddoc -%}

<svg
  class="custom-icon{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'shipping' -%}
      <path d="M2.5 7h12v9h-12z" />
      <path d="M14.5 10h3.2l3.3 3v3h-6.5z" />
      <circle cx="6.5" cy="18.5" r="1.6" />
      <circle cx="17.5" cy="18.5" r="1.6" />
    {%- when 'returns' -%}
      <path d="M4 12a8 8 0 0 1 13.66-5.66L20 8" />
      <path d="M20 4v4h-4" />
      <path d="M20 12a8 8 0 0 1-13.66 5.66L4 16" />
      <path d="M4 20v-4h4" />
    {%- when 'payment' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="1.5" />
      <line x1="2.5" y1="9.5" x2="21.5" y2="9.5" />
      <line x1="5.5" y1="14.5" x2="10.5" y2="14.5" />
    {%- when 'secure' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="1.5" />
      <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
      <circle cx="12" cy="15.5" r="1.2" />
    {%- when 'gift' -%}
      <rect x="3" y="9" width="18" height="11.5" rx="1.5" />
      <line x1="3" y1="13" x2="21" y2="13" />
      <line x1="12" y1="9" x2="12" y2="20.5" />
      <path d="M12 9c-2.5 0-4.5-.9-4.5-2.5S9 4 10 4.6 12 7 12 9zm0 0c2.5 0 4.5-.9 4.5-2.5S15 4 14 4.6 12 7 12 9z" />
    {%- when 'support' -%}
      <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2" />
      <rect x="2.5" y="13.5" width="4" height="6" rx="1.6" />
      <rect x="17.5" y="13.5" width="4" height="6" rx="1.6" />
      <path d="M19.5 19.5v.5a2.5 2.5 0 0 1-2.5 2.5h-2" />
    {%- when 'exchange' -%}
      <path d="M3.5 8.5h14l-3-3" />
      <path d="M20.5 15.5h-14l3 3" />
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.5" />
      <ellipse cx="12" cy="12" rx="3.6" ry="8.5" />
      <line x1="3.7" y1="9.2" x2="20.3" y2="9.2" />
      <line x1="3.7" y1="14.8" x2="20.3" y2="14.8" />
    {%- comment -%}
      The four footer brand marks are solid glyphs: hairline strokes blur at
      footer size. Explicit fill/stroke attributes override the stroked defaults above.
    {%- endcomment -%}
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5.2" stroke-width="2" />
      <circle cx="12" cy="12" r="4.1" stroke-width="2" />
      <circle cx="17.3" cy="6.7" r="1.3" fill="currentColor" stroke="none" />
    {%- when 'tiktok' -%}
      <path fill="currentColor" stroke="none" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
    {%- when 'whatsapp' -%}
      <path d="M4.4 16.6A8.8 8.8 0 1 1 7.9 20l-4.6 1.1z" stroke-width="2" />
      <path fill="currentColor" stroke="none" d="M9.1 7.6c.3-.3.8-.3 1 .1l1 2c.2.4.1.8-.2 1.1l-.6.6a6.4 6.4 0 0 0 3.3 3.3l.6-.6c.3-.3.7-.4 1.1-.2l2 1c.4.2.4.7.1 1l-.6.7c-.6.6-1.6.9-2.5.5A10 10 0 0 1 8 10.7c-.4-.9-.1-1.9.5-2.5z" />
    {%- when 'facebook' -%}
      <path fill="currentColor" stroke="none" transform="translate(1.5 1.5) scale(0.875)" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M9.6 20.2 12 11.4" />
      <path d="M9.2 13.6a3.6 3.6 0 0 1-.3-1.6c0-2.4 1.9-4.4 4.3-4.4 2.1 0 3.6 1.4 3.6 3.4 0 2.5-1.4 4.4-3.3 4.4-1 0-1.8-.8-1.6-1.8" />
    {%- when 'youtube' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="3.5" />
      <path d="M10.4 9.4v5.2l4.4-2.6z" />
    {%- when 'x' -%}
      <path d="M4 4l7.3 9.2L4.6 20" />
      <path d="M20 20l-7.3-9.2L19.4 4" />
    {%- when 'snapchat' -%}
      <path d="M12 3.5c2.3 0 4 1.8 4 4.1 0 1 .1 1.9-.1 2.6.5.3 1.1.2 1.6 0 .5.7-.3 1.5-1.3 1.9.6 1.8 2 3 3.3 3.3-.2.7-1.6 1-2.6 1.1-.2.4-.2 1-.5 1.1-.6.2-1.7-.4-2.9-.1-1 .3-1.6 1.5-3.5 1.5s-2.5-1.2-3.5-1.5c-1.2-.3-2.3.3-2.9.1-.3-.1-.3-.7-.5-1.1-1-.1-2.4-.4-2.6-1.1 1.3-.3 2.7-1.5 3.3-3.3-1-.4-1.8-1.2-1.3-1.9.5.2 1.1.3 1.6 0-.2-.7-.1-1.6-.1-2.6 0-2.3 1.7-4.1 4-4.1z" />
    {%- when 'star' -%}
      <path d="M12 3l2.6 5.4 5.9.9-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.1 5.9-.9z" />
    {%- when 'fabric' -%}
      <path d="M4 16c4-8 12-8 16 0" />
      <path d="M4 16h16" />
      <circle cx="12" cy="9" r="3.2" />
    {%- when 'shield' -%}
      <path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6z" />
    {%- when 'hand' -%}
      <path d="M8.5 11V5.2a1.6 1.6 0 0 1 3.2 0V11" />
      <path d="M11.7 10.4V4a1.6 1.6 0 0 1 3.2 0v6.4" />
      <path d="M14.9 11V6.6a1.6 1.6 0 0 1 3.2 0V14a7 7 0 0 1-7 7h-.6a6 6 0 0 1-5.2-3l-2-3.4a1.6 1.6 0 0 1 2.6-1.8L8.5 15" />
    {%- when 'leaf' -%}
      <path d="M20 4C10 4 4.5 8.5 4.5 15.5A4.5 4.5 0 0 0 9 20c7 0 11-5.5 11-16z" />
      <path d="M4 20c3-6 7-9.5 12-11.5" />
    {%- when 'sparkle' -%}
      <path d="M12 3.5c.6 3.9 1.6 4.9 5.5 5.5-3.9.6-4.9 1.6-5.5 5.5-.6-3.9-1.6-4.9-5.5-5.5 3.9-.6 4.9-1.6 5.5-5.5z" />
      <path d="M18 15c.3 2 .8 2.5 2.8 2.8-2 .3-2.5.8-2.8 2.8-.3-2-.8-2.5-2.8-2.8 2-.3 2.5-.8 2.8-2.8z" />
  {%- endcase -%}
</svg>
