{%- doc -%}
  Renders a thin-stroke line icon for the `custom-*` sections.

  The theme's own `icon` snippet draws filled paths; this set is stroked to match the
  Kantara design language. Renders the full <svg> element, not just the paths.

  @param {string} icon - A utility icon (shipping, returns, payment, secure, gift, support,
    exchange, globe) or a social mark (instagram, tiktok, whatsapp, facebook, pinterest,
    youtube, x, snapchat).
  @param {string} [class] - Additional classes on the <svg>
{%- enddoc -%}

<svg
  class="custom-icon{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'shipping' -%}
      <path d="M2.5 7h12v9h-12z" />
      <path d="M14.5 10h3.2l3.3 3v3h-6.5z" />
      <circle cx="6.5" cy="18.5" r="1.6" />
      <circle cx="17.5" cy="18.5" r="1.6" />
    {%- when 'returns' -%}
      <path d="M4 12a8 8 0 0 1 13.66-5.66L20 8" />
      <path d="M20 4v4h-4" />
      <path d="M20 12a8 8 0 0 1-13.66 5.66L4 16" />
      <path d="M4 20v-4h4" />
    {%- when 'payment' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="1.5" />
      <line x1="2.5" y1="9.5" x2="21.5" y2="9.5" />
      <line x1="5.5" y1="14.5" x2="10.5" y2="14.5" />
    {%- when 'secure' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="1.5" />
      <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
      <circle cx="12" cy="15.5" r="1.2" />
    {%- when 'gift' -%}
      <rect x="3" y="9" width="18" height="11.5" rx="1.5" />
      <line x1="3" y1="13" x2="21" y2="13" />
      <line x1="12" y1="9" x2="12" y2="20.5" />
      <path d="M12 9c-2.5 0-4.5-.9-4.5-2.5S9 4 10 4.6 12 7 12 9zm0 0c2.5 0 4.5-.9 4.5-2.5S15 4 14 4.6 12 7 12 9z" />
    {%- when 'support' -%}
      <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2" />
      <rect x="2.5" y="13.5" width="4" height="6" rx="1.6" />
      <rect x="17.5" y="13.5" width="4" height="6" rx="1.6" />
      <path d="M19.5 19.5v.5a2.5 2.5 0 0 1-2.5 2.5h-2" />
    {%- when 'exchange' -%}
      <path d="M3.5 8.5h14l-3-3" />
      <path d="M20.5 15.5h-14l3 3" />
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.5" />
      <ellipse cx="12" cy="12" rx="3.6" ry="8.5" />
      <line x1="3.7" y1="9.2" x2="20.3" y2="9.2" />
      <line x1="3.7" y1="14.8" x2="20.3" y2="14.8" />
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="1" />
    {%- when 'tiktok' -%}
      <path d="M14 3v10.5a3.5 3.5 0 1 1-3-3.46V7a6.5 6.5 0 1 0 6.5 6.5V9.2A6 6 0 0 0 21 10V7a4 4 0 0 1-4-4h-3z" />
    {%- when 'whatsapp' -%}
      <path d="M20 12a8 8 0 1 1-3.6-6.7L20 4l-1.1 3.7A7.96 7.96 0 0 1 20 12z" />
      <path d="M9 10c0 3 2 5 5 5" />
    {%- when 'facebook' -%}
      <path d="M14.5 8.5h2.2M14.5 8.5V6.8A1.8 1.8 0 0 1 16.3 5h1.4" />
      <path d="M14.5 8.5V21" />
      <path d="M10.5 12h6" />
      <rect x="3" y="3" width="18" height="18" rx="5" />
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9" />
      <path d="M9.6 20.2 12 11.4" />
      <path d="M9.2 13.6a3.6 3.6 0 0 1-.3-1.6c0-2.4 1.9-4.4 4.3-4.4 2.1 0 3.6 1.4 3.6 3.4 0 2.5-1.4 4.4-3.3 4.4-1 0-1.8-.8-1.6-1.8" />
    {%- when 'youtube' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="3.5" />
      <path d="M10.4 9.4v5.2l4.4-2.6z" />
    {%- when 'x' -%}
      <path d="M4 4l7.3 9.2L4.6 20" />
      <path d="M20 20l-7.3-9.2L19.4 4" />
    {%- when 'snapchat' -%}
      <path d="M12 3.5c2.3 0 4 1.8 4 4.1 0 1 .1 1.9-.1 2.6.5.3 1.1.2 1.6 0 .5.7-.3 1.5-1.3 1.9.6 1.8 2 3 3.3 3.3-.2.7-1.6 1-2.6 1.1-.2.4-.2 1-.5 1.1-.6.2-1.7-.4-2.9-.1-1 .3-1.6 1.5-3.5 1.5s-2.5-1.2-3.5-1.5c-1.2-.3-2.3.3-2.9.1-.3-.1-.3-.7-.5-1.1-1-.1-2.4-.4-2.6-1.1 1.3-.3 2.7-1.5 3.3-3.3-1-.4-1.8-1.2-1.3-1.9.5.2 1.1.3 1.6 0-.2-.7-.1-1.6-.1-2.6 0-2.3 1.7-4.1 4-4.1z" />
  {%- endcase -%}
</svg>
