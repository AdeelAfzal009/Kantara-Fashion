{% doc %}
  Cart Drawer — bespoke visual styling

  Re-skins the standard Horizon cart drawer (colors, typography, shapes,
  spacing) to match kantara-fashion-en-ar/english/cart.html, reusing the
  --custom-* tokens and fonts already loaded globally in custom-head.liquid.
  Scoped to #cart-drawer only — the standalone /cart page keeps its default
  look.
{% enddoc %}

{% stylesheet %}
  #cart-drawer .theme-drawer__title {
    font-family: var(--custom-font-display, 'Cormorant Garamond', serif);
    font-weight: 500;
  }

  html[dir='rtl'] #cart-drawer .theme-drawer__title {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    font-weight: 600;
  }

  #cart-drawer .cart-items__table-row {
    padding-bottom: 1.625rem;
    margin-bottom: 1.625rem;
    border-bottom: 1px solid var(--custom-line, #e7e5e0);
    align-items: start;
  }

  #cart-drawer .cart-items__media-container {
    background-color: var(--custom-grey, #f1f0ec);
  }

  #cart-drawer .cart-items__title {
    font-family: var(--custom-font-display, 'Cormorant Garamond', serif);
    font-weight: 500;
    font-size: 1rem;
    color: var(--custom-ink, #121212);
  }

  html[dir='rtl'] #cart-drawer .cart-items__title {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    font-weight: 600;
  }

  #cart-drawer .cart-items__variants,
  #cart-drawer .cart-items__variant {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.75rem;
    color: var(--custom-mute, #8b8579);
    line-height: 1.7;
  }

  #cart-drawer .cart-items__variant dd {
    color: var(--custom-ink, #121212);
    font-weight: 500;
  }

  html[dir='rtl'] #cart-drawer .cart-items__variants,
  html[dir='rtl'] #cart-drawer .cart-items__variant {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  #cart-drawer .cart-items__price,
  #cart-drawer .quantity-selector input {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.84375rem;
    color: var(--custom-ink, #121212);
  }

  html[dir='rtl'] #cart-drawer .cart-items__price {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  #cart-drawer .quantity-selector {
    border: 1px solid var(--custom-line, #e7e5e0);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    gap: 0.875rem;
    padding-inline: 0.75rem;
  }

  #cart-drawer .quantity-selector .quantity-minus,
  #cart-drawer .quantity-selector .quantity-plus {
    background: transparent;
    box-shadow: none;
    width: auto;
    height: auto;
    padding: 0.375rem 0;
  }

  #cart-drawer .quantity-selector input {
    border: none;
    background: transparent;
    text-align: center;
  }

  #cart-drawer .cart-items__remove {
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  /* ---------- summary ---------- */
  #cart-drawer .cart-totals__original-label,
  #cart-drawer .cart-totals__total-label,
  #cart-drawer .cart-totals__tax-note,
  #cart-drawer .cart-note__label,
  #cart-drawer .cart-discount__label {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.8125rem;
    color: var(--custom-mute, #8b8579);
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
  }

  html[dir='rtl'] #cart-drawer .cart-totals__original-label,
  html[dir='rtl'] #cart-drawer .cart-totals__total-label,
  html[dir='rtl'] #cart-drawer .cart-totals__tax-note,
  html[dir='rtl'] #cart-drawer .cart-note__label,
  html[dir='rtl'] #cart-drawer .cart-discount__label {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  #cart-drawer .cart-totals__total {
    font-size: 0.9375rem;
    color: var(--custom-ink, #121212);
  }

  #cart-drawer .cart-totals__total-value,
  #cart-drawer .cart-totals__original-value {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
  }

  html[dir='rtl'] #cart-drawer .cart-totals__total-value,
  html[dir='rtl'] #cart-drawer .cart-totals__original-value {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  #cart-drawer .cart-totals:not(:has(.cart-actions)) {
    border-block-start-color: var(--custom-line, #e7e5e0);
  }

  #cart-drawer .cart-actions {
    border-color: var(--custom-line, #e7e5e0);
  }

  #cart-drawer .cart-discount__input {
    border: none;
    border-bottom: 1px solid var(--custom-line, #e7e5e0);
    border-radius: 0;
    background: transparent;
    padding: 0.375rem 0.125rem;
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
  }

  #cart-drawer .cart-discount__button {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--custom-ink, #121212);
    background: transparent;
    border: none;
    border-radius: 0;
    border-bottom: 1px solid var(--custom-ink, #121212);
    padding: 0 0 0.125rem;
  }

  /* ---------- checkout ---------- */
  #cart-drawer .cart__checkout-button {
    border-radius: 999px;
    background-color: var(--custom-ink, #121212);
    color: var(--custom-white, #ffffff);
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
  }

  html[dir='rtl'] #cart-drawer .cart__checkout-button {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    letter-spacing: normal;
    text-transform: none;
  }

  /* ---------- empty state ---------- */
  #cart-drawer .cart-items__empty-button {
    border-radius: 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--custom-ink, #121212);
    color: var(--custom-ink, #121212);
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0 0 0.25rem;
    box-shadow: none;
  }

  html[dir='rtl'] #cart-drawer .cart-items__empty-button {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    letter-spacing: normal;
    text-transform: none;
  }

  /* ---------- item layout: fixed thumbnail, no duplicate unit price ---------- */
  #cart-drawer .cart-items__table-row--full-width-variants {
    grid-template-columns: 5.625rem minmax(0, 1fr) auto;
    grid-template-rows: min-content min-content 1fr min-content;
    grid-template-areas:
      'media details details'
      'media variants variants'
      'media quantity price'
      'media error error';
    column-gap: 1rem;
  }

  #cart-drawer .cart-items__table-row--full-width-variants .cart-items__quantity {
    align-self: end;
    margin-block-start: 0.875rem;
  }

  #cart-drawer .cart-items__table-row--full-width-variants .cart-items__price {
    align-self: end;
    justify-self: end;
    padding-block-end: 0.75rem;
  }

  #cart-drawer .cart-drawer__summary {
    margin-top: 0;
  }

  #cart-drawer .cart-items__media-container {
    aspect-ratio: 90 / 112;
    width: 5.625rem;
  }

  #cart-drawer .cart-items__media-image {
    height: 100%;
    object-position: top center;
  }

  #cart-drawer .cart-items__unit-price-wrapper {
    display: none;
  }

  #cart-drawer .cart-items__variant {
    display: block;
  }

  #cart-drawer .cart-items__variant dt.visually-hidden {
    position: static !important;
    display: inline !important;
    width: auto !important;
    height: auto !important;
    margin: 0 !important;
    overflow: visible !important;
    clip: auto !important;
    clip-path: none !important;
    white-space: normal !important;
  }

  #cart-drawer .cart-items__variant dt {
    color: var(--custom-mute, #8b8579);
  }

  #cart-drawer .cart-items__variant-sep {
    display: none;
  }

  #cart-drawer .cart-items__price {
    font-size: 0.84375rem;
  }

  #cart-drawer .cart-totals__line {
    padding-block: 0.4375rem;
  }

  #cart-drawer .cart-totals__container {
    row-gap: 0;
  }

  #cart-drawer .cart-totals__total {
    border-top: 1px solid var(--custom-line, #e7e5e0);
    margin-top: 0.5rem;
    padding-top: 1rem;
    font-weight: 400;
  }

  #cart-drawer .cart-totals__total-label {
    color: var(--custom-ink, #121212);
    font-size: 0.9375rem;
  }

  #cart-drawer .cart-totals__total-value {
    font-size: 0.9375rem;
  }

  #cart-drawer .cart-totals__tax-note {
    display: none;
  }

  #cart-drawer .cart-bnpl {
    width: 100%;
  }

  /* ---------- trash | qty | plus in one bordered box ---------- */
  #cart-drawer .cart-items__quantity-controls {
    gap: 0;
    border: 1px solid var(--custom-line, #e7e5e0);
    padding-inline: 0.75rem;
    align-items: center;
  }

  #cart-drawer .cart-items__quantity-controls .quantity-selector {
    border: 0;
    padding-inline: 0;
    gap: 0.875rem;
  }

  #cart-drawer .cart-items__quantity-controls .quantity-minus {
    display: none;
  }

  #cart-drawer .cart-items__remove {
    order: -1;
    width: auto;
    height: auto;
    padding: 0.375rem 0.875rem 0.375rem 0;
    color: var(--custom-ink, #121212);
  }

  #cart-drawer .cart-items__remove svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* ---------- discount code always visible, inline ---------- */
  #cart-drawer .cart-discount summary {
    display: none;
  }

  #cart-drawer .cart-discount .details-content {
    block-size: auto;
    opacity: 1;
    overflow: visible;
  }

  #cart-drawer .cart-discount__content {
    height: auto;
  }

  #cart-drawer .cart-discount__form {
    padding-block: 0.875rem;
  }

  #cart-drawer .cart-discount__input {
    flex: 1;
    font-size: 0.8125rem;
  }
{% endstylesheet %}
