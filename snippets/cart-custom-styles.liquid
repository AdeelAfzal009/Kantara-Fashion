{% doc %}
  Cart — bespoke visual styling

  Re-skins the standard Horizon cart drawer and /cart page (colors,
  typography, shapes, spacing) to match
  kantara-fashion-en-ar/english/cart.html, reusing the --custom-* tokens and
  fonts already loaded globally in custom-head.liquid. Shared rules are
  scoped to #cart-drawer and .cart-page; page-only layout lives at the end.
{% enddoc %}

{% stylesheet %}
  :is(#cart-drawer, .cart-page) .theme-drawer__title {
    font-family: var(--custom-font-display, 'Cormorant Garamond', serif);
    font-weight: 500;
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .theme-drawer__title {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    font-weight: 600;
  }

  :is(#cart-drawer, .cart-page) .cart-items__table-row {
    padding-bottom: 1.625rem;
    margin-bottom: 1.625rem;
    border-bottom: 1px solid var(--custom-line, #e7e5e0);
    align-items: start;
  }

  :is(#cart-drawer, .cart-page) .cart-items__media-container {
    background-color: var(--custom-grey, #f1f0ec);
  }

  :is(#cart-drawer, .cart-page) .cart-items__title {
    font-family: var(--custom-font-display, 'Cormorant Garamond', serif);
    font-weight: 500;
    font-size: 1rem;
    color: var(--custom-ink, #121212);
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-items__title {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    font-weight: 600;
  }

  :is(#cart-drawer, .cart-page) .cart-items__variants,
  :is(#cart-drawer, .cart-page) .cart-items__variant {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.75rem;
    color: var(--custom-mute, #8b8579);
    line-height: 1.7;
  }

  :is(#cart-drawer, .cart-page) .cart-items__variant dd {
    color: var(--custom-ink, #121212);
    font-weight: 500;
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-items__variants,
  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-items__variant {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  :is(#cart-drawer, .cart-page) .cart-items__price,
  :is(#cart-drawer, .cart-page) .quantity-selector input {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.84375rem;
    color: var(--custom-ink, #121212);
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-items__price {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  :is(#cart-drawer, .cart-page) .quantity-selector {
    border: 1px solid var(--custom-line, #e7e5e0);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    gap: 0.875rem;
    padding-inline: 0.75rem;
  }

  :is(#cart-drawer, .cart-page) .quantity-selector .quantity-minus,
  :is(#cart-drawer, .cart-page) .quantity-selector .quantity-plus {
    background: transparent;
    box-shadow: none;
    width: auto;
    height: auto;
    padding: 0.375rem 0;
  }

  :is(#cart-drawer, .cart-page) .quantity-selector input {
    border: none;
    background: transparent;
    text-align: center;
  }

  :is(#cart-drawer, .cart-page) .cart-items__remove {
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  /* ---------- summary ---------- */
  :is(#cart-drawer, .cart-page) .cart-totals__original-label,
  :is(#cart-drawer, .cart-page) .cart-totals__total-label,
  :is(#cart-drawer, .cart-page) .cart-totals__tax-note,
  :is(#cart-drawer, .cart-page) .cart-note__label,
  :is(#cart-drawer, .cart-page) .cart-discount__label {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.8125rem;
    color: var(--custom-mute, #8b8579);
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-totals__original-label,
  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-totals__total-label,
  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-totals__tax-note,
  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-note__label,
  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-discount__label {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  :is(#cart-drawer, .cart-page) .cart-totals__total {
    font-size: 0.9375rem;
    color: var(--custom-ink, #121212);
  }

  :is(#cart-drawer, .cart-page) .cart-totals__total-value,
  :is(#cart-drawer, .cart-page) .cart-totals__original-value {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-totals__total-value,
  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-totals__original-value {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  :is(#cart-drawer, .cart-page) .cart-totals:not(:has(.cart-actions)) {
    border-block-start-color: var(--custom-line, #e7e5e0);
  }

  :is(#cart-drawer, .cart-page) .cart-actions {
    border-color: var(--custom-line, #e7e5e0);
  }

  :is(#cart-drawer, .cart-page) .cart-discount__input {
    border: none;
    border-radius: 0;
    background: transparent;
    padding: 0.375rem 0.125rem;
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
  }

  #cart-drawer .cart-discount__input {
    border-bottom: 1px solid var(--custom-line, #e7e5e0);
  }

  :is(#cart-drawer, .cart-page) .cart-discount__button {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--custom-ink, #121212);
    background: transparent;
    border: none;
    border-radius: 0;
    border-bottom: 1px solid var(--custom-ink, #121212);
    padding: 0 0 0.125rem;
  }

  /* ---------- checkout ---------- */
  :is(#cart-drawer, .cart-page) .cart__checkout-button {
    border-radius: 999px;
    background-color: var(--custom-ink, #121212);
    color: var(--custom-white, #ffffff);
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart__checkout-button {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    letter-spacing: normal;
    text-transform: none;
  }

  /* ---------- empty state ---------- */
  :is(#cart-drawer, .cart-page) .cart-items__empty-button {
    border-radius: 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--custom-ink, #121212);
    color: var(--custom-ink, #121212);
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0 0 0.25rem;
    box-shadow: none;
  }

  html[dir='rtl'] :is(#cart-drawer, .cart-page) .cart-items__empty-button {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    letter-spacing: normal;
    text-transform: none;
  }

  /* ---------- item layout: fixed thumbnail, no duplicate unit price ---------- */
  :is(#cart-drawer, .cart-page) .cart-items__table-row--full-width-variants {
    grid-template-columns: 5.625rem minmax(0, 1fr) auto;
    grid-template-rows: min-content min-content 1fr min-content;
    grid-template-areas:
      'media details details'
      'media variants variants'
      'media quantity price'
      'media error error';
    column-gap: 1rem;
  }

  :is(#cart-drawer, .cart-page) .cart-items__table-row--full-width-variants .cart-items__quantity {
    align-self: end;
    margin-block-start: 0.875rem;
  }

  :is(#cart-drawer, .cart-page) .cart-items__table-row--full-width-variants .cart-items__price {
    align-self: end;
    justify-self: end;
    padding-block-end: 0.75rem;
  }

  :is(#cart-drawer, .cart-page) .cart-drawer__summary {
    margin-top: 0;
  }

  :is(#cart-drawer, .cart-page) .cart-items__media-container {
    position: relative;
    aspect-ratio: 90 / 112;
    width: 5.625rem;
    height: auto;
  }

  /* Pinned to the box: Safari won't resolve height: 100% against an
     aspect-ratio-sized parent and draws the photo at its natural size. */
  :is(#cart-drawer, .cart-page) .cart-items__media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
    object-position: top center;
  }

  :is(#cart-drawer, .cart-page) .cart-items__unit-price-wrapper {
    display: none;
  }

  :is(#cart-drawer, .cart-page) .cart-items__variant {
    display: block;
  }

  :is(#cart-drawer, .cart-page) .cart-items__variant dt.visually-hidden {
    position: static !important;
    display: inline !important;
    width: auto !important;
    height: auto !important;
    margin: 0 !important;
    overflow: visible !important;
    clip: auto !important;
    clip-path: none !important;
    white-space: normal !important;
  }

  :is(#cart-drawer, .cart-page) .cart-items__variant dt {
    color: var(--custom-mute, #8b8579);
  }

  :is(#cart-drawer, .cart-page) .cart-items__variant-sep {
    display: none;
  }

  :is(#cart-drawer, .cart-page) .cart-items__price {
    font-size: 0.84375rem;
  }

  :is(#cart-drawer, .cart-page) .cart-totals__line {
    padding-block: 0.4375rem;
  }

  :is(#cart-drawer, .cart-page) .cart-totals__container {
    row-gap: 0;
  }

  :is(#cart-drawer, .cart-page) .cart-totals__total {
    border-top: 1px solid var(--custom-line, #e7e5e0);
    margin-top: 0.5rem;
    padding-top: 1rem;
    font-weight: 400;
  }

  :is(#cart-drawer, .cart-page) .cart-totals__total-label {
    color: var(--custom-ink, #121212);
    font-size: 0.9375rem;
  }

  :is(#cart-drawer, .cart-page) .cart-totals__total-value {
    font-size: 0.9375rem;
  }

  :is(#cart-drawer, .cart-page) .cart-totals__tax-note {
    display: none;
  }

  :is(#cart-drawer, .cart-page) .cart-bnpl {
    width: 100%;
  }

  /* ---------- trash | qty | plus in one bordered box ---------- */
  :is(#cart-drawer, .cart-page) .cart-items__quantity-controls {
    gap: 0;
    border: 1px solid var(--custom-line, #e7e5e0);
    padding-inline: 0.75rem;
    align-items: center;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity-controls .quantity-selector {
    border: 0;
    padding-inline: 0;
    gap: 0.875rem;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity-controls .quantity-minus {
    display: none;
  }

  :is(#cart-drawer, .cart-page) .cart-items__remove {
    order: -1;
    width: auto;
    height: auto;
    padding: 0.375rem 0.875rem 0.375rem 0;
    color: var(--custom-ink, #121212);
  }

  :is(#cart-drawer, .cart-page) .cart-items__remove svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* ---------- discount code always visible, inline ---------- */
  :is(#cart-drawer, .cart-page) .cart-discount summary {
    display: none;
  }

  :is(#cart-drawer, .cart-page) .cart-discount .details-content {
    block-size: auto;
    opacity: 1;
    overflow: visible;
  }

  :is(#cart-drawer, .cart-page) .cart-discount__content {
    height: auto;
  }

  :is(#cart-drawer, .cart-page) .cart-discount__form {
    padding-block: 0.875rem;
  }

  :is(#cart-drawer, .cart-page) .cart-discount__input {
    flex: 1;
    font-size: 0.8125rem;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity .quantity-selector {
    width: auto;
    height: auto;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity .quantity-selector input[type='number'] {
    width: 2rem;
    padding: 0;
    text-align: center;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity .quantity-selector button {
    width: auto;
    height: auto;
  }

  :is(#cart-drawer, .cart-page) .installment-box__terms {
    font-size: 0.625rem;
  }

  /* ---------- items scroll; discount, totals and checkout stay pinned ---------- */
  :is(#cart-drawer, .cart-page) .cart-drawer__content {
    overflow: hidden;
  }

  :is(#cart-drawer, .cart-page) .cart-drawer__items {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }

  :is(#cart-drawer, .cart-page) .cart-drawer__summary {
    position: static;
    flex: 0 0 auto;
    max-height: 62%;
    overflow-y: auto;
    mask-image: none;
    border-top: 1px solid var(--custom-line, #e7e5e0);
  }

  /* Self-contained so the drawer widget never depends on the product-page block's CSS. */
  :is(#cart-drawer, .cart-page) .cart-bnpl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  :is(#cart-drawer, .cart-page) .cart-bnpl .installment-box {
    border: 1px solid var(--custom-line, #e7e5e0);
    padding: 0.75rem 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
  }

  :is(#cart-drawer, .cart-page) .cart-bnpl .installment-box__provider {
    font-family: var(--custom-font-display, 'Cormorant Garamond', serif);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--custom-ink, #121212);
  }

  :is(#cart-drawer, .cart-page) .cart-bnpl .installment-box__terms {
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    color: var(--custom-mute, #8b8579);
    line-height: 1.5;
  }

  /* ---------- item row: exact cart.html type scale and quantity box ---------- */
  :is(#cart-drawer, .cart-page) .cart-items__title {
    font-weight: 400;
    line-height: 1.2;
  }

  :is(#cart-drawer, .cart-page) .cart-items__product-info {
    padding-block-end: 0.375rem;
  }

  :is(#cart-drawer, .cart-page) :is(.cart-items__variant dt, .cart-items__variant dd) {
    font-size: 0.75rem;
    line-height: 1.7;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity-controls {
    gap: 0.875rem;
    padding: 0.375rem 0.75rem;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity .quantity-selector {
    gap: 0.875rem;
    min-height: 0;
  }

  :is(#cart-drawer, .cart-page) :is(.cart-items__quantity .quantity-selector button, .cart-items__remove) {
    width: 0.875rem;
    height: 0.875rem;
    min-width: 0;
    min-height: 0;
    padding: 0;
  }

  :is(#cart-drawer, .cart-page) :is(.quantity-plus .svg-wrapper, .quantity-plus svg, .cart-items__remove svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  :is(#cart-drawer, .cart-page) .quantity-plus {
    color: var(--custom-ink, #121212);
  }

  :is(#cart-drawer, .cart-page) .quantity-plus svg path {
    stroke-width: 0.76;
  }

  :is(#cart-drawer, .cart-page) .cart-items__quantity .quantity-selector input[type='number'] {
    width: 1rem;
    min-width: 0.875rem;
    height: 0.875rem;
    font-size: 0.8125rem;
    line-height: 0.875rem;
  }

  @supports (field-sizing: content) {
    :is(#cart-drawer, .cart-page) .cart-items__quantity .quantity-selector input[type='number'] {
      field-sizing: content;
      width: auto;
    }
  }

  /* Centre the price on the 28px quantity box, like cart.html's row-bottom. */
  :is(#cart-drawer, .cart-page) .cart-items__table-row--full-width-variants .cart-items__price {
    padding-block-end: 0;
    line-height: 1.75rem;
  }

  /* ================= /cart page layout =================
     Mobile/tablet: one centered 640px column (title, items, summary).
     Desktop: title across the top, items left, sticky summary right. */
  .section .cart-page:not(.cart-page--empty) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto;
    gap: 0;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .cart-page .cart-page__title,
  .cart-page .cart-page__items,
  .cart-page .cart-page__summary,
  .cart-page .cart-page__more-blocks {
    grid-column: 1;
    grid-row: auto;
  }

  .cart-page .cart-title {
    text-align: center;
    padding-block: 1.25rem 0.5rem;
  }

  .cart-page .cart-title h1 {
    display: block;
    margin: 0 0 0.5rem;
    font-family: var(--custom-font-display, 'Cormorant Garamond', serif);
    font-weight: 500;
    font-size: clamp(1.625rem, 3.6vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: none;
    color: var(--custom-ink, #121212);
  }

  html[dir='rtl'] .cart-page .cart-title h1 {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
    font-weight: 600;
    font-size: clamp(1.3125rem, 2.8vw, 1.6875rem);
  }

  .cart-page .cart-title__count {
    margin: 0;
    font-family: var(--custom-font-ui, 'Inter', sans-serif);
    font-size: 0.78125rem;
    color: var(--custom-mute, #8b8579);
  }

  html[dir='rtl'] .cart-page .cart-title__count {
    font-family: var(--custom-font-arabic, 'IBM Plex Sans Arabic', sans-serif);
  }

  .cart-page .cart-page__title + .cart-page__items {
    margin-block-start: 1.25rem;
  }

  .cart-page .cart-items__table-row:first-child {
    padding-block-start: 1.625rem;
  }

  /* Summary: plain white, no extended panel or padding box */
  .cart-page .cart-page__summary {
    display: block;
    height: auto;
    padding-block: 0 0.625rem;
  }

  .cart-page .cart-totals__line .cart-totals__original-value {
    color: var(--custom-mute, #8b8579);
  }

  .cart-page .cart-summary {
    display: block;
    height: auto;
    border: none;
    background: transparent;
  }

  .cart-page .cart-summary__inner {
    width: 100%;
    padding: 0;
    gap: 0;
    align-items: stretch;
  }

  .cart-page .cart-summary__inner > .cart-totals {
    width: 100%;
  }

  .cart-page .cart-actions {
    border-block-start: none;
    margin-block-start: 0;
    margin-block-end: 1.375rem;
  }

  .cart-page .cart-bnpl {
    margin-block: 1.375rem 0.25rem;
  }

  .cart-page .cart__ctas {
    margin-block-start: 1.375rem;
    gap: 0.625rem;
  }

  .cart-page .cart__checkout-button {
    width: 100%;
    min-height: 0;
    padding: 0.9375rem;
  }

  .cart-page .cart__checkout-button:hover {
    opacity: 0.85;
  }

  .cart-page shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-button-border-radius: 999px;
  }

  /* cart.html shrinks thumbnails to 76px on phones (drawer included) */
  @media screen and (max-width: 480px) {
    :is(#cart-drawer, .cart-page) .cart-items__table-row--full-width-variants {
      grid-template-columns: 4.75rem minmax(0, 1fr) auto;
    }

    :is(#cart-drawer, .cart-page) .cart-items__media-container {
      width: 4.75rem;
    }
  }

  @media screen and (min-width: 990px) {
    .section .cart-page:not(.cart-page--empty) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 6vw, 6rem);
      max-width: 75rem;
    }

    .cart-page .cart-page__title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .cart-page .cart-page__items {
      grid-column: 1;
      grid-row: 2;
    }

    .cart-page .cart-page__summary {
      grid-column: 2;
      grid-row: 2;
      margin-block-start: 1.25rem;
      padding-block-start: 1.625rem;
    }

    .cart-page .cart-summary__inner {
      position: sticky;
      top: calc(var(--header-height, 0px) + 1.5rem);
    }

    .cart-page .cart-page__more-blocks {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}
